@unpublished{belles2026motherhood,
  bibtex_show={true},
  title={Motherhood and the onset of intimate-partner violence},
  author={Bell{\'e}s-Obrero, Cristina and Lombardi, Mar{\'i}a and Navajas-Ahumada, Camila and Pedrazzi, Juli{\'a}n},
  note={CEDLAS Working Paper. Submitted},
  year={2026},
  abstract={This paper estimates the causal impact of first-time motherhood on the onset of physical or sexual intimate partner violence (IPV). We use retrospective data from Peru's Demographic and Health Surveys (2004-2019), and conduct a stacked difference-in-differences estimation comparing first-time mothers to observationally similar women who conceive three years later, matching on pre-conception characteristics. Unlike previous studies based on administrative data, we address the key empirical challenge of constructing a credible counterfactual by exploiting detailed survey data on pre-conception relationship characteristics and incorporating these characteristics into the matching procedure. We find that motherhood increases the likelihood of IPV onset by 4.3 percentage points (a 29% increase) within two years after conception. Importantly, we find that failing to account for pre-conception relationship characteristics when constructing the comparison group leads to substantial upward bias, highlighting their importance for credibly identifying the causal effect of motherhood on IPV.},
  pdf={https://www.cedlas.econo.unlp.edu.ar/wp/wp-content/uploads/doc_cedlas381.pdf},
  preview={cedlas_wp.png}
}

@unpublished{aguero2026privacy,
  bibtex_show={true},
  title={Privacy and measurement error in phone surveys: The case of women's agency},
  author={Ag{\"u}ero, Jorge M. and Pedrazzi, Juli{\'a}n and Perego, Viviana M.E. and Romero, Javier},
  note={CEDLAS Working Paper (forthcoming). Submitted},
  year={2026},
  abstract={There is a growing literature focusing on measurement error in self-reported data. This paper studies the case of women's agency, a key outcome in economic development, and introduces a simple and cost-effective corrective measure to enhance the reliability of data collection around sensitive topics. The study draws from a survey experiment in rural Guatemala where 1,183 women received the same questions about their agency as part of a phone survey, but the privacy of their responses was varied. Women in the control group answered verbally. The first treatment group used code words to conceal answers from potential bystanders. The second treatment arm used the phone keypad to conceal answers from bystanders and the enumerator alike. The paper finds that women answering under higher levels of privacy report lower levels of agency, by 0.19 standard deviations on an aggregate index. The effects of the two privacy treatments cannot be statistically distinguished. The effect is concentrated among women with higher social standing, and qualitative interviews indicate that agency is socially valued in this setting. Both patterns point to social desirability bias as the most likely explanation for why reported agency responds to privacy.},
  pdf={privacy_agency.pdf},
  preview={privacy_agency.png}
}

